# Fournisseur de modèle : fake (hors ligne), anthropic ou azure_openai
LLM_PROVIDER=fake

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Corpus chargé au démarrage (extrait de démonstration par défaut)
CORPUS_PATH=data/sample/ai_act_sample.md
TOP_K=4

# Recherche dense optionnelle (pip install ".[dense]")
DENSE_MODEL=

# Stockage local : points de reprise du graphe et journal d'audit
STATE_DIR=var

# Clé exigée sur les routes de relecture humaine (en-tête X-Reviewer-Key)
REVIEWER_API_KEY=
